# Inverter MCP server configuration. Copy to ~/.config/inverter-mcp.env and chmod 600.
# Environment variables set on the process take precedence over this file.

# Where the dashboard (app.py) is. On the Pi itself: http://127.0.0.1:5000
# From a laptop on the LAN: http://192.168.18.130:5000
INVERTER_URL=http://127.0.0.1:5000
INVERTER_USERNAME=admin
INVERTER_PASSWORD=

# Safety switches.
#   READ_ONLY=1 registers no tool that changes anything (status / history / bill tools only).
#   ALLOW_PARAM_WRITES=1 additionally exposes set_inverter_parameter (battery voltages, charge
#   currents, battery type, output frequency). Off by default: those can damage a battery bank.
INVERTER_MCP_READ_ONLY=0
INVERTER_MCP_ALLOW_PARAM_WRITES=0

# Only for `--transport streamable-http` (a chatbot or remote host connecting over the network).
# Every request must carry "Authorization: Bearer <INVERTER_MCP_TOKEN>".
# Generate one with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
INVERTER_MCP_TRANSPORT=stdio
INVERTER_MCP_HOST=127.0.0.1
INVERTER_MCP_PORT=8765
INVERTER_MCP_TOKEN=
# Host header values accepted over http, comma-separated (DNS-rebinding guard). Leave empty to
# accept any Host when bound to a non-loopback address; the bearer token is the real gate.
# INVERTER_MCP_ALLOWED_HOSTS=192.168.18.130:8765,inverter.local:8765
